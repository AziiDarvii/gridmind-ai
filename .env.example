# Copy to .env (never commit .env). Read by backend/app/config.py.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=gridmind
# Optional: enables Claude reasoning in the Root Cause and Report agents
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# GRIDMIND_MAX_ITERATIONS=3
# GRIDMIND_DISABLE_LLM=1
